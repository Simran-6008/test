{{page-title "Charts"}}
<div class="container-fluid px-0" style="max-width: 90%; margin: 0 auto;">

    <ChartNav />

    <div class="container my-5">

        {{#if (eq this.model.type "charts")}}
        <h1 class="text-center mb-3 text-primary">Charts</h1>

        <div class="d-flex mb-3 justify-content-center">
            <div class="d-flex">
                <input class="form-control me-2 text-primary w-auto" type="search" placeholder="Search chart"
                    aria-label="Search" {{on "input" this.onInputChange}} id="searchInput">
                <button class="btn btn-outline-warning" type="button" {{on "click" this.doSearch}}>
                    <span class="text-primary">Search</span>
                </button>
            </div>
        </div>

        <div class="accordion accordion-flush" id="accordionCharts">
            {{#each this.filteredCharts as |chart index|}}
            <div class="accordion-item mb-1">
                <h2 class="accordion-header text-primary">
                    <button class="accordion-button collapsed text-primary fs-5 bg-warning" type="button"
                        data-bs-toggle="collapse" data-bs-target="#chart{{index}}">
                        {{chart.modules.title}}
                    </button>
                </h2>
                <div id="chart{{index}}" class="accordion-collapse collapse" data-bs-parent="#accordionCharts">
                    <div class="accordion-body">
                        <div class="row g-4">
                            {{#each chart.modules.url as |video|}}
                            <div class="col-12 col-sm-6 col-lg-4">
                                <div class="card h-100 shadow-sm">
                                    <div class="ratio ratio-16x9">
                                        <iframe src="" data-src={{video}} title="Video" allowfullscreen></iframe>
                                    </div>
                                    <div class="card-body">
                                        <p class="card-text text-primary">
                                            {{chart.modules.video_title_or_description}}
                                        </p>
                                    </div>
                                </div>
                            </div>
                            {{/each}}
                        </div>
                    </div>
                </div>
            </div>
            {{/each}}
        </div>
        {{/if}}

        {{#if (eq this.model.type "vocabulary")}}
        <h3 class="text-center mb-4">Vocabulary Cards</h3>

        <div class="container my-4">
            <div class="accordion accordion-flush" id="accordionCharts">
                {{#each this.model.vocabulary as |vocabulary index|}}
                <div class="accordion-item mb-1">
                    <h2 class="accordion-header text-primary">
                        <button class="accordion-button collapsed text-primary fs-5 bg-warning" type="button"
                            data-bs-toggle="collapse" data-bs-target="#chart{{index}}">
                            {{vocabulary.modules.title}}
                        </button>
                    </h2>
                    <div id="chart{{index}}" class="accordion-collapse collapse" data-bs-parent="#accordionCharts">
                        <div class="accordion-body">
                            <div class="row g-4">
                                {{#each vocabulary.modules.videourl as |video|}}
                                <div class="col-12 col-sm-6 col-lg-4">
                                    <div class="card h-100 shadow-sm">
                                        <div class="ratio ratio-16x9">
                                            <iframe src="" data-src={{video}} title="Video" allowfullscreen></iframe>
                                        </div>
                                        <div class="card-body">
                                            <p class="card-text text-primary">
                                                {{vocabulary.modules.video_title_or_description}}
                                            </p>
                                        </div>
                                    </div>
                                </div>
                                {{/each}}
                                {{#each vocabulary.modules.imageurl as |image imgIndex|}}

                                <div class="col-12 col-sm-6 col-md-4">

                                    <div class="card h-100 shadow-sm vocabulary-card border-0">

                                        <img src="{{image.sm.url}}" class="card-img-top rounded cursor-pointer" alt=""
                                            style="height: 250px; object-fit: cover; cursor: pointer;"
                                            data-bs-toggle="modal" data-bs-target="#imageModal{{index}}{{imgIndex}}">

                                    </div>

                                </div>

                                <!-- Modal -->
                                <div class="modal fade" id="imageModal{{index}}{{imgIndex}}" tabindex="-1">

                                    <div class="modal-dialog modal-dialog-centered modal-xl">

                                        <div class="modal-content bg-transparent border-0">

                                            <!-- Close Button -->
                                            <div class="modal-header border-0">

                                                <button type="button"
                                                    class="btn-close btn-close-white bg-white rounded-circle p-2"
                                                    data-bs-dismiss="modal">
                                                </button>

                                            </div>

                                            <!-- Image -->
                                            <div class="modal-body text-center">

                                                <img src="{{image.lg.url}}" class="img-fluid rounded shadow" alt=""
                                                    style="max-height: 85vh; object-fit: contain;">

                                            </div>

                                        </div>

                                    </div>

                                </div>

                                {{/each}}
                            </div>
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>

        </div>
        {{/if}}



        {{#if (eq this.model.type "spoken")}}

        <h3 class="text-center mb-3">Spoken English Activity</h3>

        <div class="accordion accordion-flush" id="accordionCharts">

            {{#each this.model.spoken as |spoken index|}}

            <div class="accordion-item mb-2 border-0 shadow-sm overflow-hidden rounded-0">

                <h2 class="accordion-header">

                    <button class="accordion-button collapsed text-primary fs-6  bg-warning rounded-0"
                        type="button" data-bs-toggle="collapse" data-bs-target="#spoken{{index}}" aria-expanded="false"
                        aria-controls="spoken{{index}}">

                        {{spoken.modules.title}}

                    </button>

                </h2>

                <div id="spoken{{index}}" class="accordion-collapse collapse" data-bs-parent="#accordionCharts">

                    <div class="accordion-body">

                        <div class="row g-4">

                            {{#each spoken.modules.url as |video|}}

                            <div class="col-12 col-sm-6 col-lg-4">

                                <div class="card h-100 shadow-sm border-0 rounded-0">

                                    <div class="ratio ratio-16x9">
                                        <iframe src={{video}} title="Spoken English Video" allowfullscreen>
                                        </iframe>
                                    </div>

                                </div>

                            </div>

                            {{/each}}

                        </div>

                    </div>

                </div>

            </div>

            {{/each}}

        </div>

        {{/if}}



        {{#if (eq this.model.type "annual")}}
        <h3 class="text-center mb-lg-5">Annual Days</h3>
        <div class="accordion accordion-flush" id="accordionCharts">
            {{#each this.model.annual as |annual index|}}
            <div class="accordion-item mb-1 border-0">
                <h2 class="accordion-header text-primary">
                    <button class="accordion-button  collapsed text-primary fs-5 bg-warning" type="button"
                        data-bs-toggle="collapse" data-bs-target="#chart{{index}}">
                        {{annual.modules.title}}
                    </button>
                </h2>
                <div id="chart{{index}}" class="accordion-collapse collapse" data-bs-parent="#accordionCharts">
                    <div class="accordion-body">
                        <div class="row g-4">
                            {{#each annual.modules.video as |video|}}
                            <div class="col-12 col-sm-6 col-lg-4">
                                <div class="card h-100 shadow-sm">
                                    <div class="ratio ratio-16x9">
                                        <iframe src="" data-src={{video}} title="Video" allowfullscreen></iframe>
                                    </div>
                                    <div class="card-body">
                                        <p class="card-text text-primary">

                                        </p>
                                    </div>
                                </div>
                            </div>
                            {{/each}}
                        </div>
                    </div>
                </div>
            </div>
            {{/each}}
        </div>


        {{/if}}

    </div>
</div>

{{outlet}}