{{page-title "Charts"}}
<div class="container-fluid px-0" style="max-width: 90%; margin: 0 auto;">

    <ChartNav />

    <div class="container my-5">

        {{#if (eq this.model.type "charts")}}
        <h1 class="text-center mb-3 text-primary">Charts</h1>

        <div class="d-flex mb-3 justify-content-center">
            <div class="d-flex">
                <input class="form-control me-2 text-primary w-auto" type="search" placeholder="Search chart"
                    aria-label="Search" oninput={{this.onInputChange}} id="searchInput">
                <button class="btn btn-outline-warning" type="button" onclick={{this.doSearch}}>
                    <span class="text-primary">Search</span>
                </button>
            </div>
        </div>

        <div class="accordion accordion-flush" id="accordionCharts" >
            {{#each this.filteredCharts as |chart index|}}
            <div class="accordion-item mb-1">
                <h2 class="accordion-header text-primary">
                    <button class="accordion-button collapsed text-primary fs-5 bg-warning" type="button"
                        data-bs-toggle="collapse" data-bs-target="#chart{{index}}">
                        {{chart.modules.title}}
                    </button>
                </h2>
                <div id="chart{{index}}" class="accordion-collapse collapse" data-bs-parent="#accordionCharts">
                    <div class="accordion-body">
                        <div class="row g-4">
                            {{#each chart.modules.url as |video|}}
                            <div class="col-12 col-sm-6 col-lg-4">
                                <div class="card h-100 shadow-sm">
                                    <div class="ratio ratio-16x9">
                                        <iframe src="" data-src={{video}} title="Video" allowfullscreen></iframe>
                                    </div>
                                    <div class="card-body">
                                        <p class="card-text text-primary">
                                            {{chart.modules.video_title_or_description}}
                                        </p>
                                    </div>
                                </div>
                            </div>
                            {{/each}}
                        </div>
                    </div>
                </div>
            </div>
            {{/each}}
        </div>
        {{/if}}

        {{#if (eq this.model.type "vocabulary")}}
        <h3 class="text-center mb-4">Vocabulary Cards</h3>
        <div class="container my-4">
            <div class="row g-4">
                {{#each this.model.vocabulary as |vocabulary index|}}
                <div class="col-12 col-sm-6 col-md-4">
                    <div class="card h-100 shadow-sm vocabulary-card position-relative">
                        <img src="{{vocabulary.modules.photo}}" class="card-img-top" alt="card{{index}}">
                        <!-- TOOLTIP STYLE BOX -->
                        <div class="custom-tooltip">

                            <!-- IMAGE BUTTON -->
                            <button class="btn btn-light btn-sm" type="button" data-bs-toggle="modal"
                                data-bs-target="#imageModal{{index}}">
                                Image
                            </button>

                            <!-- VIDEO BUTTON -->
                            <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="modal"
                                data-bs-target="#videoModal{{index}}">
                                Video
                            </button>

                        </div>


                        <div class="card-body">
                            <h2 class="card-title text-center">{{vocabulary.modules.title}}</h2>
                        </div>
                    </div>

                </div>
                <!-- IMAGE MODAL -->
                <div class="modal fade" id="imageModal{{index}}" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-lg">

                        <div class="modal-content">

                            <div class="modal-header">
                                <h5 class="modal-title">
                                    {{vocabulary.modules.title}} Image
                                </h5>

                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>

                            <div class="modal-body text-center">
                                <div class="row g-3">

                                    {{#each vocabulary.modules.imageurl as |image|}}

                                    <div class="col-6">

                                        <img src="{{image.sm.url}}" class="img-fluid rounded shadow-sm w-100"
                                            style="height: 250px; object-fit: cover;" alt="image">
                                    </div>

                                    {{/each}}

                                </div>

                            </div>

                        </div>

                    </div>
                </div>

                <!-- VIDEO MODAL -->
                <div class="modal fade" id="videoModal{{index}}" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-lg">

                        <div class="modal-content">

                            <div class="modal-header">
                                <h5 class="modal-title">
                                    {{vocabulary.modules.title}} Video
                                </h5>

                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>

                            <div class="modal-body">
                                <div class="row g-3">

                                    {{#each vocabulary.modules.videourl as |video|}}

                                    <div class="col-12">
                                        <video class="w-100 rounded shadow-sm" controls>
                                            <source src="{{video.url}}" type="video/mp4">
                                        </video>

                                    </div>
                                    {{/each}}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>
        </div>
        {{/if}}

        {{#if (eq this.model.type "spoken")}}
        <h3 class="text-center mb-3">Spoken English Activity</h3>
        <div class="row g-4">
            {{#each this.model.spoken as |spoken|}}
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="ratio ratio-16x9">
                        <iframe src="{{spoken.modules.url}}" title="Video" allowfullscreen></iframe>
                    </div>
                    <div class="card-body">
                        <p class="card-text">{{spoken.modules.title}}</p>
                    </div>
                </div>
            </div>
            {{/each}}
        </div>
        {{/if}}



        {{#if (eq this.model.type "annual")}}
        <h3 class="text-center mb-lg-5">Annual Days</h3>
        <div class="accordion accordion-flush" id="accordionCharts">
            {{#each this.model.annual as |annual index|}}
            <div class="accordion-item mb-1 border-0">
                <h2 class="accordion-header text-primary">
                    <button class="accordion-button  collapsed text-primary fs-5" type="button"
                        data-bs-toggle="collapse" style="background-color: #ecc02e;" data-bs-target="#chart{{index}}">
                        {{annual.modules.title}}
                    </button>
                </h2>
                <div id="chart{{index}}" class="accordion-collapse collapse" data-bs-parent="#accordionCharts">
                    <div class="accordion-body">
                        <div class="row g-4">
                            {{#each annual.modules.video as |video|}}
                            <div class="col-12 col-sm-6 col-lg-4">
                                <div class="card h-100 shadow-sm">
                                    <div class="ratio ratio-16x9">
                                        <iframe src="{{video}}" title="Video" allowfullscreen></iframe>
                                    </div>
                                    <div class="card-body">
                                        <p class="card-text text-primary">

                                        </p>
                                    </div>
                                </div>
                            </div>
                            {{/each}}
                        </div>
                    </div>
                </div>
            </div>
            {{/each}}
        </div>


        {{/if}}


    </div>
</div>
{{outlet}}